{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "worker.js",
      "wrangler.jsonc",
      "README.txt",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "**/*.@(css|js|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  }
}
